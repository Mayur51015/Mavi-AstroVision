# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/mavi-astrovision
# For Atlas cloud: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mavi-astrovision

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Admin Credentials (for setup)
ADMIN_EMAIL=admin@maviastrovision.com
ADMIN_PASSWORD=admin@123

# Astrology API Configuration
ASTROLOGY_API_KEY=your-astrologyapi-key-here
ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com/v1

# Email Configuration (Gmail SMTP)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Admin features
ENABLE_EMAIL_VERIFICATION=true
ENABLE_CHART_GENERATION=true
